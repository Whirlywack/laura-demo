# Copy to .env.local and fill in. Never commit real values.

# Supabase (hosted project): the page reads with the anon key, the server writes with the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs: the API key, the Laura agent, and the phone number she calls from.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# The number Laura dials when Call now is pressed (E.164, e.g. +37060000000).
LIDIA_PHONE_NUMBER=

# Shared secret ElevenLabs sends in the x-laura-secret header on every tool call.
LAURA_WEBHOOK_SECRET=

# Typed into the page before Call now places a call. Without it, Call now refuses every call.
CALL_NOW_PASSWORD=

# The deployed app's address; `npm run laura-agent` points Laura's tools at it.
LAURA_APP_URL=
